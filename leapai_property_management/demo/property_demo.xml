        <field name="date_end">2025-12-31</field>
        <field name="payment_term">quarterly</field>
        <field name="security_deposit">50000</field>
        <field name="admin_fee">2500</field>
        <field name="state">active</field>
        <field name="notes">&lt;p&gt;&lt;strong&gt;Terms and Conditions:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Tenant is responsible for utility bills (DEWA, Etisalat).&lt;/li&gt;&lt;li&gt;No subletting without written consent of the landlord.&lt;/li&gt;&lt;li&gt;Tenant must maintain the property in good condition.&lt;/li&gt;&lt;li&gt;90 days notice required for non-renewal.&lt;/li&gt;&lt;/ul&gt;</field>
